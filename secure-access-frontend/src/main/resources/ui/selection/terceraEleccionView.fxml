<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="500.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.secureaccess.app.secureaccessfrontend.controllers.eleccionControllers.terceraEleccionController">

   <stylesheets>
      <java.net.URL value="@../../styles/styles.css" />
   </stylesheets>

   <top>
      <AnchorPane prefHeight="60.0" prefWidth="500.0" BorderPane.alignment="CENTER">
         <children>
            <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#regresarAEleccion" styleClass="button-secondary" text="Regresar" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
         </children>
      </AnchorPane>
   </top>

   <center>
      <VBox alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" BorderPane.alignment="CENTER">
         <children>

            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="350.0" styleClass="role-box">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/administrador.png" />
                     </image>
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                  </ImageView>

                  <Label styleClass="role-title" text="Administrador">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>

                  <Label text="Acceso autorizado para personal administrativo del sistema" wrapText="true" alignment="CENTER" maxWidth="300.0">
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </Label>

                  <Button mnemonicParsing="false" onAction="#accesoLoginAdministrador" prefHeight="40.0" maxWidth="Infinity" styleClass="button-citizen" text="Ingresar como Administrador">
                     <VBox.margin>
                        <Insets bottom="25.0" />
                     </VBox.margin>
                  </Button>

                  <VBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="list-item" text="• Control global de los distintos perfiles" wrapText="true" />
                        <Label styleClass="list-item" text="• Acceso a registros de información" wrapText="true" />
                        <Label styleClass="list-item" text="• Gestión de solicitudes de cuentas" wrapText="true" />
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </center>
</BorderPane>
