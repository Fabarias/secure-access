<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="750.0" prefWidth="900.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.secureaccess.app.secureaccessfrontend.controllers.users.RegistroCiudadanoController">

   <stylesheets>
      <URL value="@../../styles/styles.css" />
   </stylesheets>

   <top>
      <AnchorPane prefHeight="60.0" BorderPane.alignment="CENTER">
         <children>
            <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#regresarAlLoginCiudadano" styleClass="button-secondary" text="Regresar al Login" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
         </children>
      </AnchorPane>
   </top>

   <center>
      <VBox alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
         <children>

            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="550.0" styleClass="role-box">
               <children>

                  <Label styleClass="role-title" text="Registro de Ciudadano">
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Complete sus datos personales para crear una cuenta" wrapText="true" alignment="CENTER" style="-fx-text-fill: #8892B0;">
                     <VBox.margin>
                        <Insets bottom="25.0" />
                     </VBox.margin>
                  </Label>

                  <VBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>

                        <VBox spacing="5.0">
                           <Label text="Nombres" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                           <TextField fx:id="nombreCiudadano" prefHeight="35.0" promptText="Ingrese sus nombres" styleClass="citizen-input" />
                        </VBox>

                        <HBox spacing="15.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <Label text="Primer Apellido" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                                 <TextField fx:id="primerApellidoCiudadano" prefHeight="35.0" promptText="Apellido Paterno" styleClass="citizen-input" />
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <Label text="Segundo Apellido" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                                 <TextField fx:id="segundoApellidoCiudadano" prefHeight="35.0" promptText="Apellido Materno" styleClass="citizen-input" />
                              </VBox>
                           </children>
                        </HBox>

                        <VBox spacing="5.0">
                           <Label text="Correo Electrónico" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                           <TextField fx:id="usuarioCorreo" prefHeight="35.0" promptText="ejemplo@correo.com" styleClass="citizen-input" />
                        </VBox>

                        <HBox spacing="15.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <Label text="Nombre de Usuario" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                                 <TextField fx:id="usuarioCiudadano" prefHeight="35.0" promptText="Cree un usuario único" styleClass="citizen-input" />
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <Label text="Contraseña" style="-fx-font-weight: bold; -fx-text-fill: #E6F1FF;" />
                                 <PasswordField fx:id="claveCiudadano" prefHeight="35.0" promptText="Cree una clave segura" styleClass="citizen-input" />
                              </VBox>
                           </children>
                        </HBox>

                     </children>
                     <VBox.margin>
                        <Insets bottom="30.0" />
                     </VBox.margin>
                  </VBox>

                  <Button mnemonicParsing="false" onAction="#registrarCiudadano" prefHeight="45.0" maxWidth="Infinity" styleClass="button-citizen" text="Registrarme">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Button>

               </children>
               <padding>
                  <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
               </padding>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>
