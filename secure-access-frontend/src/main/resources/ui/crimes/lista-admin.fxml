<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" styleClass="root" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.secureaccess.app.secureaccessfrontend.controllers.crimes.ListaDelincuentesAdminController">

    <top>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <AnchorPane>
                    <children>
                        <Label alignment="CENTER" layoutX="200.0" mouseTransparent="true" styleClass="title-header" text="Observatorio de Delincuentes (Administración)" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

                        <Button mnemonicParsing="false" onAction="#regresarAlMenu" styleClass="button-secondary" text="Regresar al Menú" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="5.0" />
                    </children>
                </AnchorPane>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="filtroNombre" prefHeight="35.0" prefWidth="200.0" promptText="Buscar por Nombres" styleClass="admin-input" />
                        <TextField fx:id="filtroApellidos" prefHeight="35.0" prefWidth="200.0" promptText="Buscar por Apellidos" styleClass="admin-input" />

                        <ComboBox fx:id="comboDepartamentos" prefHeight="35.0" prefWidth="220.0" promptText="Filtrar por Departamento" styleClass="admin-combo" visibleRowCount="6" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#onClickBotonBuscar" prefHeight="35.0" prefWidth="120.0" styleClass="button-admin" text="Buscar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <AnchorPane BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tablaDelincuentes" layoutX="20.0" layoutY="0.0" prefHeight="200.0" prefWidth="200.0" styleClass="admin-table" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="0.0">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombres" />
                        <TableColumn fx:id="colApellidos" prefWidth="150.0" text="Apellidos" />
                        <TableColumn fx:id="colDelito" prefWidth="180.0" text="Delito Principal" />
                        <TableColumn fx:id="colRecompensa" prefWidth="120.0" text="Recompensa" />
                        <TableColumn fx:id="colFechaRegistro" prefWidth="160.0" text="Fecha Registro" />
                        <TableColumn fx:id="colUsuarioRegistro" prefWidth="180.0" text="Registrado Por" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </center>

</BorderPane>
