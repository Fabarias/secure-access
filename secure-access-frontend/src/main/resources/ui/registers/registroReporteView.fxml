<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="root" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.secureaccess.app.secureaccessfrontend.controllers.registersControllers.RegistroReporteController">

   <top>
      <AnchorPane prefHeight="60.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#regresar" styleClass="button-secondary" text="Regresar al Menú" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
         </children>
      </AnchorPane>
   </top>

   <center>
      <VBox alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" BorderPane.alignment="CENTER">
         <children>

            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="500.0" styleClass="role-box">
               <children>

                  <Label styleClass="role-title" text="Nuevo Reporte Ciudadano">
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Complete los detalles para notificar a las autoridades" wrapText="true" alignment="CENTER">
                     <VBox.margin>
                        <Insets bottom="25.0" />
                     </VBox.margin>
                  </Label>

                  <VBox spacing="15.0" alignment="CENTER_LEFT">
                     <children>

                        <VBox spacing="5.0">
                           <Label text="Departamento del Suceso" style="-fx-font-weight: bold;" />

                           <ComboBox fx:id="comboDepartamento" maxWidth="Infinity" prefHeight="40.0" promptText="Seleccione el departamento" styleClass="citizen-combo" visibleRowCount="3"/>
                        </VBox>

                        <VBox spacing="5.0">
                           <Label text="Nivel de Gravedad / Categoría" style="-fx-font-weight: bold;" />

                           <ComboBox fx:id="comboGravedad" maxWidth="Infinity" prefHeight="40.0" promptText="Seleccione la gravedad" styleClass="citizen-combo" />
                        </VBox>

                        <VBox spacing="5.0">
                           <Label text="Descripción de los hechos" style="-fx-font-weight: bold;" />

                           <TextArea fx:id="txtDescripcion" prefHeight="120.0" wrapText="true" promptText="Describa lo sucedido con el mayor detalle posible..." styleClass="citizen-input" />
                        </VBox>

                     </children>
                     <VBox.margin>
                        <Insets bottom="30.0" />
                     </VBox.margin>
                  </VBox>

                  <Button mnemonicParsing="false" onAction="#enviarReporte" prefHeight="45.0" maxWidth="Infinity" styleClass="button-citizen" text="Enviar Reporte">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Button>

               </children>
               <padding>
                  <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
               </padding>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>
